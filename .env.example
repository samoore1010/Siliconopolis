# ---- global ----
MODE=mock                      # mock | live  (per-adapter overrides below)
APP_ENV=local                  # local | staging | production
DRY_RUN=false                  # true = live reads, no external writes
LOG_LEVEL=INFO
LOG_FORMAT=json                # json | text

# ---- Anthropic ----
ANTHROPIC_API_KEY=
MODEL_RESEARCH=claude-opus-5-5
MODEL_WORKER=claude-sonnet-5-5
MODEL_CHEAP=claude-haiku-5-5
# LLM_PROVIDER=anthropic|mock — defaults to anthropic when ANTHROPIC_API_KEY is set, otherwise mock.
LLM_PROVIDER=

# ---- database ----
# Local dev only. On Railway the Postgres plugin injects DATABASE_URL (postgresql://...).
DATABASE_URL=sqlite:///./pipeline.db

# ---- storage ----
STORAGE_BACKEND=local          # local | s3
STORAGE_DIR=./storage
# Railway bucket variables (reference them: ${{storage.ENDPOINT}} etc.)
S3_ENDPOINT=
S3_BUCKET=
S3_REGION=auto
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# ---- Etsy (Open API v3) ----
ETSY_MODE=                     # optional per-adapter override: mock | live
ETSY_API_KEY=
ETSY_SHARED_SECRET=
ETSY_SHOP_ID=
ETSY_OAUTH_ACCESS_TOKEN=       # seeds oauth_tokens table on first run only
ETSY_OAUTH_REFRESH_TOKEN=      # seeds oauth_tokens table on first run only
ETSY_REDIRECT_URI=http://localhost:8000/oauth/etsy/callback

# ---- Printify (phase 2) ----
PRINTIFY_MODE=
PRINTIFY_API_TOKEN=
PRINTIFY_SHOP_ID=

# ---- image generation ----
IMAGE_PROVIDER=mock            # mock | openai | google | ideogram (only mock implemented)
IMAGE_API_KEY=

# ---- guardrails / caps ----
DAILY_DRAFT_CAP=10
WEEKLY_BRIEF_CAP=20
MAX_DAILY_SPEND_USD=10

# ---- web (optional service) ----
PORT=8000
