# ---- global ----
MODE=mock                      # mock | live  (per-adapter overrides below)
APP_ENV=local                  # local | staging | production
DRY_RUN=false                  # true = live reads, no external writes
LOG_LEVEL=INFO
LOG_FORMAT=json                # json | text

# ---- Anthropic ----
ANTHROPIC_API_KEY=
MODEL_RESEARCH=claude-opus-5-5
MODEL_WORKER=claude-sonnet-5-5
MODEL_CHEAP=claude-haiku-5-5
# LLM_PROVIDER=anthropic|mock — defaults to anthropic when ANTHROPIC_API_KEY is set, otherwise mock.
LLM_PROVIDER=

# ---- database ----
# Local dev only. On Railway the Postgres plugin injects DATABASE_URL (postgresql://...).
DATABASE_URL=sqlite:///./pipeline.db

# ---- storage ----
STORAGE_BACKEND=local          # local | s3
STORAGE_DIR=./storage
# Railway bucket variables (reference them: ${{storage.ENDPOINT}} etc.)
S3_ENDPOINT=
S3_BUCKET=
S3_REGION=auto
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# ---- Etsy (Open API v3) ----
ETSY_MODE=                     # optional per-adapter override: mock | live
ETSY_API_KEY=
ETSY_SHARED_SECRET=
ETSY_SHOP_ID=
ETSY_OAUTH_ACCESS_TOKEN=       # seeds oauth_tokens table on first run only
ETSY_OAUTH_REFRESH_TOKEN=      # seeds oauth_tokens table on first run only
ETSY_REDIRECT_URI=http://localhost:8000/oauth/etsy/callback

# ---- Printify (phase 2) ----
PRINTIFY_MODE=
PRINTIFY_API_TOKEN=
PRINTIFY_SHOP_ID=

# ---- image generation ----
IMAGE_PROVIDER=mock            # mock | openai
IMAGE_API_KEY=                 # OpenAI API key when IMAGE_PROVIDER=openai
IMAGE_MODEL=gpt-image-1.5      # OpenAI image model
IMAGE_QUALITY=high             # low | medium | high (wall art)
MOCKUP_SCENES=true             # AI lifestyle backgrounds for listing images (cached + reused)
MOCKUP_QUALITY=medium          # quality for those backgrounds

# ---- guardrails / caps ----
DAILY_DRAFT_CAP=10
WEEKLY_BRIEF_CAP=20
MAX_DAILY_SPEND_USD=10

# ---- web service / village dashboard ----
PORT=8000
# Required on Railway: HTTP basic auth for /village, /api/village/*, /status and /oauth/etsy/start.
# /health stays public. Locally, leaving these empty keeps the village open.
VILLAGE_USER=
VILLAGE_PASSWORD=
# Optional "Run now" buttons: a Railway API token plus the cron service ids per agent group.
# RAILWAY_ENVIRONMENT_ID is injected by Railway automatically.
RAILWAY_API_TOKEN=
RAILWAY_SERVICE_IDS={"researcher": "", "daily": "", "analyst": ""}

# In-house merch (catalog.yaml): print shop login for /print, and Etsy ids for physical listings
PRINT_USER=
PRINT_PASSWORD=
ETSY_SHIPPING_PROFILE_ID=
ETSY_PRODUCTION_PARTNER_ID=
ETSY_READINESS_STATE_ID=
ETSY_RETURN_POLICY_ID=
